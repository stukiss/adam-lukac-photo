# Skopíruj ako .env (súbor .env sa necommituje) a doplň hodnoty.
# Bez SMTP_HOST sa pri vývoji e-maily neposielajú, ale ukladajú do server/outbox/*.eml.

# NODE_ENV=production
PORT=3000
# Na VPS za nginx nechaj 127.0.0.1, server bude dostupný len cez nginx.
HOST=127.0.0.1
# Za reverznou proxy (nginx) nastav na true, aby obmedzenie počtu dopytov videlo skutočnú IP.
TRUST_PROXY=false

# Kam chodia dopyty
MAIL_TO=adamlukacphoto@gmail.com

# SMTP schránka, z ktorej server posiela (napr. web@tvojadomena.sk na hostingu)
SMTP_HOST=
SMTP_PORT=465
# true pre port 465 (SSL), false pre 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Odosielateľ – mal by byť z tej istej domény ako SMTP schránka (inak padá do spamu)
MAIL_FROM=
